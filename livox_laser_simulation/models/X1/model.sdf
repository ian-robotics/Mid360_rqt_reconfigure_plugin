<?xml version="1.0"?>
<sdf version="1.6">
    <model name="X1">
        <enable_wind>1</enable_wind>
        <static>0</static>
        <link name="base_link">
            <inertial>
                <pose frame="">0.0 0.0 0.062 0 0 0</pose>
                <mass>46.034</mass>
                <inertia>
                    <ixx>0.613201</ixx>
                    <ixy>-0.0236401</ixy>
                    <ixz>-0.1197</ixz>
                    <iyy>1.7496</iyy>
                    <iyz>-0.00154411</iyz>
                    <izz>2.0406</izz>
                </inertia>
            </inertial>
            <collision name="base_link_collision">
                <pose frame="">0 0 0.12 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.9874 0.5709 0.05</size>
                    </box>
                </geometry>
            </collision>
            <collision name="base_link_collision_bottom">
                <pose frame="">0 0 0.046 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.80 0.5709 0.095</size>
                    </box>
                </geometry>
            </collision>
            <collision name="base_link_collision_1">
                <pose frame="">0 0 0.185625 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.78992 0.5709 0.12375</size>
                    </box>
                </geometry>
            </collision>
            <collision name="top_plate_collision">
                <pose frame="">0.0812 0 0.245 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/top_plate.dae</uri>
                    </mesh>
                </geometry>
            </collision>
            <collision name="top_plate_collision_2">
                <pose frame="">0.0812 0 0.245 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.32 0.41 0.09</size>
                    </box>
                </geometry>
            </collision>
            <visual name="base_link_visual">
                <pose frame="">0 0 0 0 0 -3.14159</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/chassis.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            
            <visual name="left_headlight_visual">
                <pose frame="">0.461459 0.216803 0.124431 0 0 -3.14159</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/headlight.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="marker_visual_1">
                <pose frame="">0.066047 0.212211 0.209188 -3.14159 1.57079 -1.60259</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/led.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="marker_visual_2">
                <pose frame="">-0.066047 0.212211 0.209188 -3.14159 1.57079 -1.60259</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/led.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="marker_visual_3">
                <pose frame="">-0.42493 0 0.209188 3.14159 1.57079 7e-06</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/led.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="marker_visual_4">
                <pose frame="">-0.42493 0.13619 0.209188 3.14159 1.57079 7e-06</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/led.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="marker_visual_5">
                <pose frame="">-0.42493 -0.13619 0.209188 3.14159 1.57079 7e-06</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/led.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="right_headlight_visual">
                <pose frame="">0.461459 -0.216803 0.124431 0 0 -3.14159</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/headlight.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="marker_visual_6">
                <pose frame="">0.066047 -0.212211 0.209188 3.14159 1.57079 1.60259</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/led.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="marker_visual_7">
                <pose frame="">-0.066047 -0.212211 0.209188 3.14159 1.57079 1.60259</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/led.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="top_plate_visual">
                <pose frame="">0.0812 0 0.245 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/top_plate.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            
            <sensor name="imu_sensor" type="imu">
                <always_on>1</always_on>
                <update_rate>50</update_rate>
                <imu>
                    <enable_orientation>0</enable_orientation>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.009</stddev>
                                <bias_mean>0.00075</bias_mean>
                                <bias_stddev>0.005</bias_stddev>
                                <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
				<dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
				<precision>0.00025</precision>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.009</stddev>
                                <bias_mean>0.00075</bias_mean>
                                <bias_stddev>0.005</bias_stddev>
                                <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
				<dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
				<precision>0.00025</precision>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.009</stddev>
                                <bias_mean>0.00075</bias_mean>
                                <bias_stddev>0.005</bias_stddev>
                                <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
				<dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
				<precision>0.00025</precision>
                            </noise>
                        </z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.021</stddev>
                                <bias_mean>0.05</bias_mean>
                                <bias_stddev>0.0075</bias_stddev>
                                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
				<dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
				<precision>0.005</precision>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.021</stddev>
                                <bias_mean>0.05</bias_mean>
                                <bias_stddev>0.0075</bias_stddev>
                                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
				<dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
				<precision>0.005</precision>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.021</stddev>
                                <bias_mean>0.05</bias_mean>
                                <bias_stddev>0.0075</bias_stddev>
                                <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
				<dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
				<precision>0.005</precision>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
            <!-- The two 1280x960 front cameras were removed to save rendering
                 performance; restore them from Downloads/X1_Config_5 if
                 needed. The IMU sensor above is kept (useful for FAST-LIO). -->
            <!-- Mid-360 LiDAR mounted on the top plate -->
            <visual name="lidar_visual">
                <pose>0.0812 0 0.29 0 0 0</pose>
                <geometry>
                    <mesh>
                        <scale>1 1 1</scale>
                        <uri>model://Mid360/meshes/livox_mid-360-90x.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.34 0.34 0.36 1</ambient>
                    <diffuse>0.34 0.34 0.36 1</diffuse>
                </material>
            </visual>
            <sensor type="gpu_lidar" name="laser_livox">
                <pose>0.0812 0 0.34 0 0 0</pose>
                <visualize>false</visualize>
                <always_on>True</always_on>
                <update_rate>10</update_rate>
                <topic>/livox/mid360/scan</topic>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159265358</min_angle>
                            <max_angle>3.14159265358</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>100</samples>
                            <resolution>1</resolution>
                            <min_angle>-1.57079632679</min_angle>
                            <max_angle>1.57079632679</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>45</max>
                        <resolution>0.02</resolution>
                    </range>
                </lidar>
            </sensor>

        </link>
        <link name="front_left_wheel">
            <pose frame="">0.256 0.2854 0.03282 0 0 0</pose>
            <inertial>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.04411</iyy>
                    <iyz>0</iyz>
                    <izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose frame="">0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/wheel.dae</uri>
                    </mesh>
                </geometry>
            </visual>
        </link>
        <joint name="front_left_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>front_left_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>
        <link name="front_right_wheel">
            <pose frame="">0.256 -0.2854 0.03282 0 0 0</pose>
            <inertial>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.04411</iyy>
                    <iyz>0</iyz>
                    <izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose frame="">0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/wheel.dae</uri>
                    </mesh>
                </geometry>
            </visual>
        </link>
        <joint name="front_right_wheel_joint" type="revolute">
            <child>front_right_wheel</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>
        <link name="rear_left_wheel">
            <pose frame="">-0.256 0.2854 0.03282 0 0 0</pose>
            <inertial>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.04411</iyy>
                    <iyz>0</iyz>
                    <izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose frame="">0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/wheel.dae</uri>
                    </mesh>
                </geometry>
            </visual>
        </link>
        <joint name="rear_left_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>rear_left_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>
        <link name="rear_right_wheel">
            <pose frame="">-0.256 -0.2854 0.03282 0 0 0</pose>
            <inertial>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.04411</iyy>
                    <iyz>0</iyz>
                    <izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose frame="">0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://X1/meshes/wheel.dae</uri>
                    </mesh>
                </geometry>
            </visual>
        </link>
        <joint name="rear_right_wheel_joint" type="revolute">
            <child>rear_right_wheel</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <!-- Skid-steer drive: gz-sim has no native skid-steer system, so the
             front and rear axles each get a DiffDrive instance and both
             subscribe to the same /cmd_vel topic. -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <wheel_separation>0.5708</wheel_separation>
            <wheel_radius>0.1651</wheel_radius>
            <topic>/cmd_vel</topic>
        </plugin>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <wheel_separation>0.5708</wheel_separation>
            <wheel_radius>0.1651</wheel_radius>
            <topic>/cmd_vel</topic>
        </plugin>

        <!-- Mid-360 adapter: gz scan -> ROS 2 point cloud (same wiring as the
             standalone Mid360 model). -->
        <plugin filename="liblivox_laser_simulation_gz.so"
                name="livox_laser_simulation::LivoxGzSystem">
            <gz_scan_topic>/livox/mid360/scan</gz_scan_topic>
            <csv_file>model://Mid360/scan_mode/mid360-flipped.csv</csv_file>
            <samples>18000</samples>
            <downsample>1</downsample>
            <min_range>0.1</min_range>
            <max_range>45.0</max_range>
            <publish_pointcloud_type>2</publish_pointcloud_type>
            <ros_topic>/livox/lidar</ros_topic>
            <frame_name>livox_link</frame_name>
            <use_sim_time>true</use_sim_time>
            <!-- Publish the TRUE simulation pose as TF (odom -> X1/base_link);
                 wheel odometry is unusable on this skid-steer vehicle. -->
            <tf_child_frame>X1/base_link</tf_child_frame>
            <publish_max_range>false</publish_max_range>
        </plugin>
    </model>
</sdf>
